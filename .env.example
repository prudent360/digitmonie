# --- Required in production ---------------------------------------------
# Postgres connection string (e.g. Neon). Leave unset locally to use the embedded PGlite database in .data/.
DATABASE_URL=
# At least 32 characters: openssl rand -base64 32
SESSION_SECRET=
# The first administrator, created once if missing. They set up two-factor sign-in on first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Public URL used in invitation links, e.g. https://digitmonie.com
NEXT_PUBLIC_SITE_URL=

# --- Messaging --------------------------------------------------------------
# Termii for SMS codes. Without it, codes are printed to the server log (and shown on screen in development).
TERMII_API_KEY=
TERMII_SENDER_ID=DigitMonie
# Resend for email (staff invitations, codes for staff without a phone).
RESEND_API_KEY=
EMAIL_FROM="DigitMonie <hello@digitmonie.com>"
